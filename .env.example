# Copy to .env and adjust. Never commit real secrets.

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave empty to use SQLite (default). For PostgreSQL:
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/cake_house_db

REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production: set DEBUG=False and use real values